<clickhouse>
    <!-- 컨테이너 밖(Prometheus)에서 붙을 수 있게 모든 인터페이스에 바인딩한다. -->
    <listen_host>0.0.0.0</listen_host>
    <!-- 클릭 이벤트 적재량(Kafka Engine → MV)을 Prometheus로 노출한다. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
