{
  "uid": "url-short-hotkey",
  "title": "url-short · 핫키 admission",
  "tags": [
    "url-short",
    "hotkey",
    "admission",
    "cache"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "핫키 목록 크기",
      "description": "redirect 인스턴스가 현재 들고 있는 핫키 목록 크기(dashboard가 발행한 상위 조회 키 개수). L1 적재는 이 목록에 있는 키로만 제한된다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(urlcache_hotkeys_size{application=\"redirect\"})",
          "refId": "A",
          "legendFormat": "핫키 수"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "JVM 힙 사용량",
      "description": "redirect 인스턴스별 힙 사용량. admission이 힙을 지키고 있는지의 직접 지표.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance) (jvm_memory_used_bytes{application=\"redirect\", area=\"heap\"})",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "L1 히트율",
      "description": "L1(로컬) 조회 중 히트 비율. admission이 좁힌 목록이 실제로 히트를 잘 흡수하는지 확인.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum (rate(urlcache_hits_total{application=\"redirect\",layer=\"l1\"}[1m])) / clamp_min(sum (rate(urlcache_admission_total{application=\"redirect\"}[1m])), 0.001)",
          "refId": "A",
          "legendFormat": "L1 hit ratio"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "admission 거부 비율",
      "description": "핫키 목록에 없어 L1 적재를 건너뛴 비율. 높을수록 admission이 더 많은 키를 걸러 힙을 아끼고 있다는 뜻.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(urlcache_admission_total{result=\"rejected\"}[1m])) / sum(rate(urlcache_admission_total[1m]))",
          "refId": "A",
          "legendFormat": "rejected ratio"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "메모리를 지키는 admission",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM 힙 사용량 (instance별) · admission on/off",
      "description": "왼쪽 축 = 인스턴스별 힙 사용량. 오른쪽 축(점선) = admission 활성 여부(0/1). admission을 끈 구간에서 힙이 계단식으로 치솟으면 admission이 힙을 지키고 있었다는 증거.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance) (jvm_memory_used_bytes{application=\"redirect\", area=\"heap\"})",
          "refId": "A",
          "legendFormat": "heap ({{instance}})"
        },
        {
          "expr": "max(urlcache_hotkeys_admission_enabled{application=\"redirect\"})",
          "refId": "B",
          "legendFormat": "admission enabled (0/1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "axisPlacement": "left",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "admission enabled (0/1)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    6,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "계층별 서빙 & admission 판정",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "계층별 서빙 분포 (L1 / L2 / DB)",
      "description": "요청을 누가 응답했나. admission이 정상이면 핫키는 L1이 흡수하고, 목록 밖 키만 L2·DB로 내려간다.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(urlcache_hits_total{layer=\"l1\"}[1m]))",
          "refId": "A",
          "legendFormat": "L1 히트"
        },
        {
          "expr": "sum(rate(urlcache_hits_total{layer=\"l2\"}[1m]))",
          "refId": "B",
          "legendFormat": "L2(Redis) 히트"
        },
        {
          "expr": "sum(rate(urlcache_loads_total[1m]))",
          "refId": "C",
          "legendFormat": "DB 로드"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "admission 판정 (허용 / 거부)",
      "description": "L1 적재 판정 결과. 거부(rejected)는 핫키 목록 밖이라 L1을 건너뛴 요청 수.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(urlcache_admission_total{result=\"admitted\"}[1m]))",
          "refId": "A",
          "legendFormat": "허용(admitted)"
        },
        {
          "expr": "sum(rate(urlcache_admission_total{result=\"rejected\"}[1m]))",
          "refId": "B",
          "legendFormat": "거부(rejected)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "허용(admitted)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "거부(rejected)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "핫키 전파 & 클릭 이벤트",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "핫키 발행 · 수신",
      "description": "왼쪽 축 = dashboard가 발행한 목록 크기 vs redirect 인스턴스가 실제로 들고 있는 크기(수렴해야 정상). 오른쪽 축 = 증분 메시지 적용/유실 비율. skipped가 늘면 중간 메시지를 놓쳐 다음 전체 스냅샷을 기다리는 중이라는 뜻.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "hotkey_published_size{application=\"dashboard\"}",
          "refId": "A",
          "legendFormat": "발행 크기(dashboard)"
        },
        {
          "expr": "urlcache_hotkeys_size{application=\"redirect\"}",
          "refId": "B",
          "legendFormat": "수신 크기 ({{instance}})"
        },
        {
          "expr": "sum(rate(urlcache_hotkeys_messages_total{result=\"applied\"}[1m]))",
          "refId": "C",
          "legendFormat": "적용(applied)"
        },
        {
          "expr": "sum(rate(urlcache_hotkeys_messages_total{result=\"skipped\"}[1m]))",
          "refId": "D",
          "legendFormat": "유실(skipped)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "axisPlacement": "left",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "적용(applied)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "유실(skipped)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "발행 크기(dashboard)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "클릭 이벤트 파이프라인",
      "description": "왼쪽 축 = Kafka 발행 결과(초당). 오른쪽 축 = 발행 대기 큐 크기. 큐가 차서 dropped가 늘면 응답 지연을 지키려고 집계용 이벤트를 버리고 있다는 뜻.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(click_events_total{result=\"published\"}[1m]))",
          "refId": "A",
          "legendFormat": "발행(published)"
        },
        {
          "expr": "sum(rate(click_events_total{result=\"failed\"}[1m]))",
          "refId": "B",
          "legendFormat": "실패(failed)"
        },
        {
          "expr": "sum(rate(click_events_total{result=\"dropped\"}[1m]))",
          "refId": "C",
          "legendFormat": "버림(dropped)"
        },
        {
          "expr": "sum(click_events_queue_size{application=\"redirect\"})",
          "refId": "D",
          "legendFormat": "큐 크기(queue size)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "axisPlacement": "left",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "발행(published)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "실패(failed)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "버림(dropped)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "큐 크기(queue size)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    6,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "응답 지연",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "리다이렉트 응답 지연 (p50 / p95 / p99)",
      "description": "admission·힙 상태가 실제 응답 지연에 어떻게 반영되는지 확인. GC 압박이나 L1 미스 급증은 여기 꼬리 지연으로 드러난다.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"redirect\", uri!~\".*actuator.*\"}[1m])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"redirect\", uri!~\".*actuator.*\"}[1m])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"redirect\", uri!~\".*actuator.*\"}[1m])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "__inputs": [],
  "__requires": []
}