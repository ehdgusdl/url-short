      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT pct, coverage, marker FROM (\n  SELECT pct, CAST(coverage AS Nullable(Float64)) AS coverage, CAST(NULL AS Nullable(Float64)) AS marker FROM (\n    SELECT round(rank / 1000232 * 100, 1) AS pct,\n           round(max(cum) / (SELECT sum(clicks) FROM click_rank_snapshot) * 100, 2) AS coverage\n    FROM (SELECT rank, sum(clicks) OVER (ORDER BY rank ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum\n          FROM click_rank_snapshot)\n    GROUP BY pct\n    UNION ALL SELECT 100.0 AS pct, 100.0 AS coverage\n  )\n  UNION ALL SELECT 9.99, CAST(NULL AS Nullable(Float64)), CAST(0 AS Nullable(Float64))\n  UNION ALL SELECT 10.01, CAST(NULL AS Nullable(Float64)), CAST(100 AS Nullable(Float64))\n) ORDER BY pct",
          "format": 1,
          "queryType": "table"
        }
      ],
      "options": {
