    {
      "id": 3,
      "type": "bargauge",
      "title": "Marginal efficiency E(p) = ΔH / ΔM × 100  ·  %p per 100MB · θ=10",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT concat(toString(round(prev_p*100,2)), ' → ', toString(round(p*100,2)), '%') AS step,\n       round((hit_ratio - prev_hit) / (cache_mb - prev_mb) * 100, 1) AS E\nFROM (SELECT p, cache_mb, hit_ratio,\n             lagInFrame(p)         OVER (ORDER BY p) AS prev_p,\n             lagInFrame(cache_mb)  OVER (ORDER BY p) AS prev_mb,\n             lagInFrame(hit_ratio) OVER (ORDER BY p) AS prev_hit\n      FROM sweep_result)\nWHERE prev_p > 0 ORDER BY p",
          "format": 1,
          "queryType": "table"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {}
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "sweep summary · 힙 예산 102MB · θ=10",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT concat(toString(round(p*100,2)), '%') AS `p (admission ratio)`,\n       round(cache_mb, 1) AS `cache heap (MB)`,\n       round(hit_ratio, 1) AS `hit ratio (%)`,\n       if(prev_p = 0, NULL, round((hit_ratio - prev_hit) / (cache_mb - prev_mb) * 100, 1)) AS `E(step→p)`,\n       if(cache_mb <= 102.4, 'within budget', 'over budget') AS budget\nFROM (SELECT p, cache_mb, hit_ratio,\n             lagInFrame(p)         OVER (ORDER BY p) AS prev_p,\n             lagInFrame(cache_mb)  OVER (ORDER BY p) AS prev_mb,\n             lagInFrame(hit_ratio) OVER (ORDER BY p) AS prev_hit\n      FROM sweep_result) ORDER BY p",
          "format": 1,
          "queryType": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "budget"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "within budget": {
                        "color": "green",
                        "index": 0
                      },
                      "over budget": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "E(step→p)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
